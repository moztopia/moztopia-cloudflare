{
    "name": "moztopia/cloudflare-example",
    "description": "A self-contained Laravel demonstration of Moztopia Cloudflare.",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": "~8.5.13",
        "laravel/framework": "^13.17",
        "moztopia/cloudflare": "^0.9"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../",
            "options": {
                "symlink": true,
                "reference": "none",
                "versions": {"moztopia/cloudflare": "0.9.1"}
            }
        }
    ],
    "autoload": {"psr-4": {"App\\": "app/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "lint": "pint --test"
    },
    "config": {
        "platform": {"php": "8.5.13"},
        "allow-plugins": {"pestphp/pest-plugin": true},
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
